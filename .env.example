# Required for day-31 analysis (extractor + synthesizer)
ANTHROPIC_API_KEY=

# Optional: Telegram alerts. Create a bot via @BotFather, then run
#   python scripts/test_telegram.py --discover
# after sending any message to the bot to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: run collector headed for debugging (default: headless)
HEADLESS=1

# Optional: absolute path to the existing leadmagnet-post-writer SKILL.md.
# Used by the dashboard /skill draft panel for side-by-side comparison
# against the new skill. Without it the draft panel is hidden.
LEADMAGNET_SKILL_PATH=

# Optional: your own LinkedIn profile URL. If set, run_analysis emits a
# personalized audit at output/profile_audit.md based on the patterns
# learned from peers. Your profile is scraped ad-hoc and never enters the
# comparable creator pool.
MY_PROFILE_URL=
